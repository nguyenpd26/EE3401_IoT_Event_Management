{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build IoT Event Management System",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-g",
                "-I${workspaceFolder}/include",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/SensorGenerator.cpp",
                "${workspaceFolder}/src/RingBuffer.cpp",
                "${workspaceFolder}/src/EventQueue.cpp",
                "${workspaceFolder}/src/HashTable.cpp",
                "-o",
                "${workspaceFolder}/iot_system.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}